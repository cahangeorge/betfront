---
import Layout from '#/layouts/Layout.astro';
import { AuthForm } from '#/components/AuthForm';

if (Astro.locals.user) return Astro.redirect('/');

let next = new URL(Astro.request.url).searchParams.get('next') ?? '/';
if (next === '/') next = '/';
---

<Layout title="Betfront — Login">
  <main class="flex min-h-[calc(100dvh-3.5rem)] items-center justify-center px-4 py-8 md:py-12">
    <div class="mx-auto w-full max-w-sm space-y-6">
      <div class="text-center">
        <p class="island-kicker mb-2">Welcome back</p>
        <h1 class="display-title text-3xl font-bold text-[var(--sea-ink)]">Sign in</h1>
        <p class="mt-2 text-[var(--sea-ink-soft)]">Access your bankrolls, predictions, and tickets.</p>
      </div>
      <AuthForm mode="login" next={next} client:load />
      <p class="text-center text-sm text-[var(--sea-ink-soft)]">
        No account?        <a href={`/signup?next=${encodeURIComponent(next)}`} class="text-[var(--lagoon-deep)] font-medium">Create one</a>
      </p>
    </div>
  </main>
</Layout>
