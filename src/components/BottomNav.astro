---
const path = Astro.url.pathname;
const BETFRONT_BASE = '/betfront';
const isActive = (href: string) => {
  const fullHref = href === '/' ? BETFRONT_BASE : href.startsWith(BETFRONT_BASE) ? href : `${BETFRONT_BASE}${href}`;
  return path === fullHref || path.startsWith(`${fullHref}/`);
};

const tabs = [
  {
    href: BETFRONT_BASE,
    label: 'Home',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`,
  },
  {
    href: '/betfront/data',
    label: 'Data',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>`,
  },
  {
    href: '/betfront/predict',
    label: 'Predict',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>`,
  },
  {
    href: '/betfront/tickets',
    label: 'Tickets',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2z"/><line x1="9" y1="2" x2="9" y2="22"/></svg>`,
  },
  {
    href: '/betfront/jobs',
    label: 'Jobs',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
  },
  {
    href: '/betfront/account',
    label: 'Account',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>`,
  },
];
---

<nav
  class="fixed bottom-0 inset-x-0 z-40 md:hidden border-t border-[var(--line)] bg-[var(--header-bg)] backdrop-blur-lg"
  style="padding-bottom: env(safe-area-inset-bottom)"
  aria-label="Main navigation"
>
  <div class="flex items-stretch h-16">
    {
      tabs.map((tab) => (
        <a
          href={tab.href}
          class:list={[
            'flex flex-col items-center justify-center flex-1 gap-0.5 text-[10px] font-semibold no-underline transition-colors duration-150 select-none',
            isActive(tab.href)
              ? 'text-[var(--lagoon-deep)]'
              : 'text-[var(--sea-ink-soft)] hover:text-[var(--sea-ink)]',
          ]}
        >
          <span
            class:list={[
              'flex items-center justify-center w-9 h-6 rounded-full transition-[background-color] duration-150',
              isActive(tab.href) && 'bg-[color-mix(in_oklab,var(--lagoon)_18%,transparent)]',
            ]}
            set:html={tab.icon}
          />
          {tab.label}
        </a>
      ))
    }
  </div>
</nav>
